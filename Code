"""
Automatisierte Stellensuche: Tourismus / Kultur / Marketing im Raum Riedenburg
==============================================================================
NUR VOLLZEIT-STELLEN (Teilzeit wird herausgefiltert)

Was macht das Skript?
1. Geht eine Liste von Städten, Gemeinden, Landkreisen und Tourismus-Stellen durch.
2. Findet auf jeder Webseite automatisch die Seite mit den Stellenangeboten.
3. Durchsucht diese Seiten (inkl. PDFs) nach passenden Stichwörtern.
4. Ermittelt die Arbeitszeit (Vollzeit / Teilzeit) aus Titel, PDF oder Detailseite
   und filtert reine Teilzeitstellen heraus.
5. Speichert die Treffer als CSV + HTML-Bericht und markiert NEUE Stellen.

Installation (einmalig):
    pip install requests beautifulsoup4 pypdf

Start:
    python stellensuche_riedenburg_vollzeit.py
    python stellensuche_riedenburg_vollzeit.py --streng      (auch "unbekannt" raus)
    python stellensuche_riedenburg_vollzeit.py --ohne-pdf    (schneller)
    python stellensuche_riedenburg_vollzeit.py --nur-neue    (nur neue Treffer)
"""

import argparse
import csv
import io
import json
import re
import time
from datetime import datetime
from pathlib import Path
from urllib.parse import urljoin, urlparse
from urllib.robotparser import RobotFileParser

import requests
from bs4 import BeautifulSoup

try:
    from pypdf import PdfReader
except ImportError:          # PDF-Suche ist optional
    PdfReader = None


# ---------------------------------------------------------------------------
# 1) KONFIGURATION – hier kannst du alles anpassen
# ---------------------------------------------------------------------------

# Name -> (Startseite, direkte Stellenseite oder None)
# URLs bitte einmal im Browser prüfen.
ORTE = {
    # Landkreis Kelheim
    "Stadt Riedenburg":            ("https://www.riedenburg.de", None),
    "Stadt Kelheim":               ("https://www.kelheim.de", None),
    "Landkreis Kelheim":           ("https://www.landkreis-kelheim.de", None),
    "Markt Essing":                ("https://www.essing.de", None),
    "Gemeinde Ihrlerstein":        ("https://www.ihrlerstein.de", None),
    "Markt Painten":               ("https://www.painten.de", None),
    "Stadt Abensberg":             ("https://www.abensberg.de", None),
    "Stadt Neustadt a.d. Donau":   ("https://www.neustadt-donau.de", None),
    "Markt Bad Abbach":            ("https://www.bad-abbach.de", None),
    "Gemeinde Saal a.d. Donau":    ("https://www.saal-donau.de", None),
    "Markt Mindelstetten":         ("https://www.mindelstetten.de", None),
    # Landkreis Eichstätt
    "Markt Altmannstein":          ("https://www.altmannstein.de", None),
    "Stadt Beilngries":            ("https://www.beilngries.de", None),
    "Markt Kipfenberg":            ("https://www.kipfenberg.de", None),
    "Markt Kinding":               ("https://www.kinding.de", None),
    "Gemeinde Denkendorf":         ("https://www.denkendorf.de", None),
    "Stadt Eichstätt":             ("https://www.eichstaett.de", None),
    "Landkreis Eichstätt":         ("https://www.landkreis-eichstaett.de", None),
    # Landkreis Neumarkt / Regensburg
    "Stadt Dietfurt a.d. Altmühl": ("https://www.dietfurt.de", None),
    "Markt Breitenbrunn":          ("https://www.breitenbrunn.de", None),
